# ==============================================================================
# Agentflow_AI — Environment Variables Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (Optional: automatically falls back to in-memory MongoDB if empty)
MONGODB_URI=mongodb://localhost:27017/agentflow_ai

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_agentflow_ai_2026_dev_mode_change_in_prod
CREDENTIAL_ENCRYPTION_KEY=32_bytes_secret_hex_key_0123456789abcdef0123456789abcdef

# Redis & Queue Configuration (Optional: in-memory fallback enabled when empty)
REDIS_URL=redis://localhost:6379

# AI Providers (At least one recommended for AI generation; rule-based fallback active otherwise)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Third-Party Integrations (OAuth & Bot credentials)
# Google OAuth (Gmail & Google Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/google/callback

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/slack/callback

# Discord Integration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/discord/callback
